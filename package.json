{
  "name": "ai-assistant",
  "version": "0.1.0",
  "description": "화면에 떠 있는 캐릭터 AI 비서 (체크메이트 일정 알림)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mobile:build": "node mobile/build.mjs",
    "mobile:serve": "node mobile/build.mjs && node mobile/serve.mjs",
    "android": "powershell -ExecutionPolicy Bypass -File mobile/build-android.ps1",
    "mobile:deploy": "node mobile/deploy.mjs"
  },
  "private": true,
  "devDependencies": {
    "electron": "^38.8.6",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "three": "^0.187.0"
  }
}
